# ==============================================================================
# BrightSmile Dental Clinic - Environment Configuration Blueprint
# ==============================================================================
# Copy this file to .env.local for local development:
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. SITE & SEO CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://brightsmiledental.in

# ------------------------------------------------------------------------------
# 2. ANALYTICS & AD TRACKING
# ------------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Meta Pixel (Facebook Ads) Pixel ID (format: 123456789012345)
NEXT_PUBLIC_META_PIXEL_ID=123456789012345

# ------------------------------------------------------------------------------
# 3. BACKEND & WEBHOOK INTEGRATIONS (OPTIONAL / EXTENSIBLE)
# ------------------------------------------------------------------------------
# Google Sheets Webhook URL (from Google Apps Script, SheetDB, or Zapier)
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXXX/exec

# Resend API Key for automatic email confirmation alerts to the clinic desk
# RESEND_API_KEY=re_1234567890abcdef

# WhatsApp Business API / Twilio Auth Token for instant patient confirmation SMS
# WHATSAPP_API_KEY=your_whatsapp_or_twilio_token_here
